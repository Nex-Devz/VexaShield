[Unit]
Description=VexaShield attack monitor
Documentation=https://github.com/nex-devz/VexaShield
After=network-online.target vexashield-firewall.service

[Service]
Type=simple
ExecStart=/usr/local/bin/vexashield monitor
Restart=always
RestartSec=5
Nice=10
MemoryMax=96M
TasksMax=16
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
